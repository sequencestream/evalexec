{
  "spec_version": "evalexec/v1alpha1",
  "eval_id": "fixture-f03",
  "task_id": "order-agent-faithfulness",
  "dataset": {"path": "dataset.jsonl"},
  "grader": {
    "id": "answer-faithfulness",
    "version": "v1",
    "protocol": "builtin",
    "entry": "llm_judge",
    "requires": ["input", "output", "trajectory"],
    "requires_judge": true,
    "parameters": {
      "rubric": "判断最终回答是否忠实于轨迹中工具返回的事实，不得臆造未出现的信息",
      "min_score": 0,
      "max_score": 1,
      "use_trajectory": true
    },
    "timeout_ms": 60000
  },
  "judge_model": {
    "protocol": "openai-chat",
    "endpoint": "https://judge.example.invalid/v1",
    "auth": {"type": "bearer_env", "env": "EVALEXEC_FIXTURE_KEY"},
    "parameters": {"model": "judge-model", "temperature": 0},
    "timeout_ms": 60000
  },
  "execution": {"concurrency": 1},
  "output_dir": "out"
}
